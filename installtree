---
- name: Install tree on Ubuntu
  hosts: all
  become: true
  gather_facts: true

  tasks:
    - name: Create directory for GPG keys
      ansible.builtin.file:
        path: /etc/apt/keyrings
        state: directory
        mode: '0755'

    - name: Download Zabbix official GPG key
      ansible.builtin.get_url:
        url: https://repo.zabbix.com/zabbix-official-repo.key
        dest: /etc/apt/keyrings/zabbix.asc
        mode: '0644'

    - name: Ensure apt cache is up to date
      ansible.builtin.apt:
        update_cache: true
        cache_valid_time: 3600

    - name: Install tree package
      ansible.builtin.apt:
        name: tree
        state: present

    - name: Verify tree is installed
      ansible.builtin.command: tree --version
      register: tree_version
      changed_when: false

    - name: Show tree version
      ansible.builtin.debug:
        msg: "{{ tree_version.stdout }}"